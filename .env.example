# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
TRUST_REVERSE_PROXY=False
SESSION_COOKIE_AGE=2592000
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_SAVE_EVERY_REQUEST=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
SECURE_CROSS_ORIGIN_RESOURCE_POLICY=same-origin

# Database (Local SQLite default)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL example:
# DATABASE_URL=postgresql://social_admin:change-this-postgres-password@localhost:5432/social_automation
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Redis / Celery
REDIS_URL=redis://:change-this-redis-password@localhost:6379/0
CACHE_BACKEND=redis
CACHE_DEFAULT_TIMEOUT_SECONDS=300
CELERY_TIMEZONE=Asia/Kolkata
CELERY_PUBLISH_RATE_LIMIT=180/m
CELERY_INSIGHTS_REFRESH_RATE_LIMIT=90/m
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
BULK_REFRESH_STALE_MINUTES=45
FORCE_REFRESH_IG_GUARD_MINUTES=20
FORCE_REFRESH_IG_GUARD_DUE_LIMIT=1
PUBLIC_BASE_URL=
DAILY_INSIGHTS_ENABLED=True
DAILY_INSIGHTS_SCHEDULE_HOUR=5
DAILY_INSIGHTS_SCHEDULE_MINUTE=0
DAILY_INSIGHTS_POST_LIMIT=100
DAILY_INSIGHTS_POST_STATS_LIMIT=40
# At scale (many connected accounts) LOWER these to cut both per-account Meta Graph
# call volume (X-App-Usage / error #4) and per-task memory. Recommended for 50+ accounts:
#   DAILY_INSIGHTS_POST_LIMIT=50
#   DAILY_INSIGHTS_POST_STATS_LIMIT=15

# --- Meta app-usage / rate-limit protection (defaults preserve current behavior) ---
# How long the cached Meta X-App-Usage peak is trusted (s). Meta's app quota is a
# rolling ~1h window, so 300-600 tracks it far better than the old hardcoded 60s.
META_USAGE_CACHE_TTL=300
# Insights refresh defers (reschedules) instead of calling Meta once cached usage hits this %.
# Publishing also hard-stops at this threshold. 100 = only act on a genuine overrun.
META_APP_USAGE_STOP_PCT=100
# Sleep-pace the heavy insights fan-out when usage is elevated (75/90%).
META_INSIGHTS_USAGE_THROTTLE=True
# Backoff (s) applied to rate-limit transients (#4/#17/#32/#613) before retrying the fan-out.
META_RATE_LIMIT_RETRY_COUNTDOWN=900
# Block a manual force-refresh-all when cached X-App-Usage is already at/above this %.
FORCE_REFRESH_APP_USAGE_BLOCK_PCT=90
# Per-user cooldown (s) between full force-refresh-all runs (prevents quota storms).
FORCE_REFRESH_ALL_COOLDOWN_SECONDS=1800
# Cap how many accounts the force-refresh-all inline (queue-down) fallback processes
# synchronously inside the web worker (protects gunicorn RAM when Celery/Redis is degraded).
FORCE_REFRESH_INLINE_FALLBACK_MAX=5
# Snapshot retention: keep the latest N InsightSnapshot rows per account; older are pruned daily.
INSIGHT_SNAPSHOT_RETENTION_PER_ACCOUNT=30
INSIGHT_SNAPSHOT_PRUNE_ENABLED=True
INSIGHT_SNAPSHOT_PRUNE_HOUR=4
INSIGHT_SNAPSHOT_PRUNE_MINUTE=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_TIMEOUT_SECONDS=90
MAX_UPLOAD_FILE_BYTES=104857600

# Meta
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
META_GRAPH_VERSION=v21.0

# Encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key
# Optional key rotation list (newest first)
# FERNET_KEYS=key1,key2

# Optional
# Example with ngrok:
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password

# Email / Help form
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="Postzyo Support <no-reply@postzyo.com>"
HELP_SUPPORT_EMAIL=1995praritsidana@gmail.com
